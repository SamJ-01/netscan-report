# Byte-compiled / cached files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Editors and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Environment / secrets
.env

# Scan output: reports can contain sensitive details about real networks,
# so they are never committed by accident. (Sample reports live in examples/.)
reports/
*.nmap
*.gnmap
